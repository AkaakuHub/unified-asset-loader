{
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"jsx": "react-jsx",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"skipLibCheck": true,
		"declaration": true,
		"rewriteRelativeImportExtensions": true,
		"outDir": "dist",
		"rootDir": "src",
		"types": []
	},
	"include": ["src"]
}
