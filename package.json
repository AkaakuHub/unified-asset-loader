{
	"name": "unified-asset-loader",
	"version": "0.1.0",
	"description": "Framework-independent asset loading, validated caching and progress APIs with optional browser, React and MUI adapters.",
	"type": "module",
	"license": "MIT",
	"sideEffects": false,
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./browser": {
			"types": "./dist/browser/index.d.ts",
			"import": "./dist/browser/index.js"
		},
		"./react": {
			"types": "./dist/react/index.d.ts",
			"import": "./dist/react/index.js"
		},
		"./mui": {
			"types": "./dist/mui/index.d.ts",
			"import": "./dist/mui/index.js"
		},
		"./domain/*": {
			"types": "./dist/domain/*.d.ts",
			"import": "./dist/domain/*.js"
		},
		"./application/*": {
			"types": "./dist/application/*.d.ts",
			"import": "./dist/application/*.js"
		},
		"./browser/*": {
			"types": "./dist/browser/*.d.ts",
			"import": "./dist/browser/*.js"
		},
		"./react/*": {
			"types": "./dist/react/*.d.ts",
			"import": "./dist/react/*.js"
		},
		"./mui/*": {
			"types": "./dist/mui/*.d.ts",
			"import": "./dist/mui/*.js"
		},
		"./presentation/*": {
			"types": "./dist/presentation/*.d.ts",
			"import": "./dist/presentation/*.js"
		}
	},
	"engines": {
		"bun": ">=1.3.14",
		"node": ">=24.22.1"
	},
	"scripts": {
		"build": "bun scripts/build.mjs",
		"test": "bun test tests",
		"prepack": "bun run build",
		"verify:package": "bun scripts/verifyPackage.mjs",
		"lint": "biome check src tests scripts package.json tsconfig.build.json biome.json",
		"format": "biome check --write src tests scripts package.json tsconfig.build.json biome.json"
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"@mui/material": "^9.0.0",
		"@emotion/react": "^11.0.0",
		"@emotion/styled": "^11.0.0"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		},
		"@mui/material": {
			"optional": true
		},
		"@emotion/react": {
			"optional": true
		},
		"@emotion/styled": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/bun": "1.3.14",
		"@types/react": "19.2.17",
		"typescript-compiler-api": "npm:typescript@6.0.3",
		"react": "19.2.7",
		"@mui/material": "9.1.1",
		"@emotion/react": "11.14.0",
		"@emotion/styled": "11.14.1",
		"@biomejs/biome": "2.5.8"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AkaakuHub/unified-asset-loader.git"
	},
	"homepage": "https://github.com/AkaakuHub/unified-asset-loader#readme",
	"bugs": {
		"url": "https://github.com/AkaakuHub/unified-asset-loader/issues"
	},
	"packageManager": "bun@1.3.14"
}
